@model RaceDay.Contracts.EventDto
@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow">
        @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
        {
            <img src="http://localhost:5194/api/events/@Model.EventId/banner" class="card-img-top" style="max-height: 400px; object-fit: cover;" alt="@Model.Name" />
        }
        
        <div class="card-header bg-primary text-white">
            <h2>@Model.Name</h2>
        </div>
        <div class="card-body">
            <p class="lead">@Model.Description</p>
            <hr />
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Date:</strong> @Model.EventDate.ToString("f")</p>
                    <p><strong>Location:</strong> @Model.Location</p>
                    <p><strong>Distance:</strong> @Model.Distance @Model.DistanceUnit</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Type:</strong> @Model.EventType</p>
                    <p><strong>Entry Fee:</strong> R @Model.EntryFee</p>
                </div>
            </div>

            <hr />
            <h4>Select a Category to Enter:</h4>
            @if (Model.Categories.Any())
            {
                <form asp-action="Enrol" method="post" class="mt-3">
                    <input type="hidden" name="eventId" value="@Model.EventId" />
                    <div class="input-group mb-3" style="max-width: 400px;">
                        <select name="categoryId" class="form-select" required>
                            <option value="">-- Choose a category --</option>
                            @foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.CategoryId">@cat.Name (R @cat.EntryFee)</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-success">Enrol Now</button>
                    </div>
                </form>
            }
            else
            {
                <p class="text-danger">No categories available for this event yet.</p>
            }
        </div>
    </div>
    <a asp-action="Index" class="btn btn-secondary mt-3">Back to Events</a>
</div>