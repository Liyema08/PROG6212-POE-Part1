@model List<RaceDay.Contracts.EventDto>
@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary">🏃 Upcoming Events</h1>
        <span class="badge bg-secondary fs-6">Participant View</span>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">There are no upcoming events at the moment. Check back later!</div>
    }
    else
    {
        <div class="row">
            @foreach (var ev in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm h-100">
                        @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                        {
                            <img src="http://localhost:5194/api/events/@ev.EventId/banner" class="card-img-top" alt="@ev.Name banner" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                                <h3>@ev.EventType</h3>
                            </div>
                        }
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@ev.Name</h5>
                            <h6 class="card-subtitle mb-2 text-muted">@ev.Location | @ev.Distance @ev.DistanceUnit</h6>
                            <p class="card-text">@ev.Description</p>
                            
                            <ul class="list-unstyled mb-3">
                                <li><strong>Date:</strong> @ev.EventDate.ToString("dd MMM yyyy")</li>
                                <li><strong>Type:</strong> @ev.EventType</li>
                                <li><strong>Entry Fee:</strong> R @ev.EntryFee</li>
                            </ul>
                        </div>
                        <div class="card-footer bg-white border-top-0">
                            <a asp-action="EventDetails" asp-route-id="@ev.EventId" class="btn btn-outline-primary w-100">View Details & Enrol</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>