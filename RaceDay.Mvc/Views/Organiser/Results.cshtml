@model List<RaceDay.Contracts.EnrolmentDto>
@{
    ViewData["Title"] = "Capture Results";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary">🏁 Capture Results for @ViewBag.EventName</h1>
        <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info">@TempData["Message"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="p-3 text-muted">No participants are enrolled in this event yet.</div>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Participant</th>
                            <th>Category</th>
                            <th>Finish Time & Position</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle fw-bold">@item.Participant?.FirstName @item.Participant?.LastName</td>
                                <td class="align-middle">@item.Category?.Name</td>
                                <td>
                                    <form asp-action="CaptureResult" method="post" class="d-flex gap-2 align-items-center">
                                        <input type="hidden" name="eventId" value="@ViewBag.EventId" />
                                        <input type="hidden" name="enrolmentId" value="@item.EnrolmentId" />
                                        
                                        <input type="text" name="finishTime" class="form-control form-control-sm" placeholder="HH:MM:SS" style="width: 120px;" required />
                                        <input type="number" name="position" class="form-control form-control-sm" placeholder="Pos" style="width: 80px;" required min="1" />
                                        
                                        <button type="submit" class="btn btn-sm btn-success">Save</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>