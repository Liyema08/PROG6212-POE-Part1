@model RaceDay.Contracts.CreateEventRequest
@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h3>Create New Event</h3>
        </div>
        <div class="card-body">
            <form asp-action="CreateEvent" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Event Name</label>
                    <input asp-for="Name" class="form-control" required />
                </div>
                
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="EventDate" class="form-label">Event Date</label>
                        <input asp-for="EventDate" type="datetime-local" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="RegistrationDeadline" class="form-label">Registration Deadline</label>
                        <input asp-for="RegistrationDeadline" type="datetime-local" class="form-control" required />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label">Location</label>
                        <input asp-for="Location" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Distance" class="form-label">Distance</label>
                        <input asp-for="Distance" type="number" step="0.1" class="form-control" required />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="DistanceUnit" class="form-label">Unit</label>
                        <select asp-for="DistanceUnit" class="form-select">
                            <option value="km">km</option>
                            <option value="miles">miles</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EventType" class="form-label">Type</label>
                        <select asp-for="EventType" class="form-select">
                            <option value="Run">Run</option>
                            <option value="Walk">Walk</option>
                            <option value="Cycle">Cycle</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EntryFee" class="form-label">Entry Fee (R)</label>
                        <input asp-for="EntryFee" type="number" step="0.01" class="form-control" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Event Banner Image</label>
                    <input type="file" name="bannerFile" class="form-control" accept="image/*" />
                </div>

                <button type="submit" class="btn btn-success mt-3">Create Event</button>
                <a asp-action="Index" class="btn btn-secondary mt-3">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}